#!/bin/sh
# launchd sends SIGTERM on unload, which the 1.6.0 watchdog exits on; the reaper then
# stops any copy launchd does not own.
JB=/var/jb
if [ -d "$JB" ]; then
    "$JB/usr/bin/launchctl" unload -w "$JB/Library/LaunchDaemons/com.jwi.wifiwatchdog.plist" 2>/dev/null
    "$JB/usr/libexec/wifi-watchdog-reap" 2>/dev/null
    rm -f "$JB/Library/LaunchDaemons/com.jwi.wifiwatchdog.plist" "$JB/usr/bin/wifi-watchdog.sh" \
          "$JB/Library/MobileSubstrate/DynamicLibraries/EAPTLS12FixV10.dylib" \
          "$JB/Library/MobileSubstrate/DynamicLibraries/EAPTLS12FixV10.plist" \
          "$JB/usr/libexec/wifi-watchdog-reap" "$JB/usr/libexec/wifi-watchdog-diag" \
          "$JB/usr/libexec/wifi-watchdog-power" "$JB/var/run/wifi-watchdog.pid"
else
    launchctl unload -w /Library/LaunchDaemons/com.jwi.wifiwatchdog.plist 2>/dev/null
    /usr/libexec/wifi-watchdog-reap 2>/dev/null
    rm -f /var/run/wifi-watchdog.pid
fi
exit 0
